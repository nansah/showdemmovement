# Copy this file to .env for local development
# Set these as environment variables on Railway

# Admin password for the /admin panel
ADMIN_PASSWORD=showdem2025

# Secret key for signing JWT tokens — change this to a random string
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Cloudinary (free account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
